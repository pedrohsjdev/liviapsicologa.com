---
import { Icon } from "astro-icon/components";

const links = [
  { to: "/", label: "Início" },
  { to: "#sobre", label: "Sobre" },
  { to: "#servicos", label: "Serviços" },
  { to: "#contato", label: "Contato" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 w-full transition-all duration-300 bg-[#F4F7F2]/80 backdrop-blur-md border-b border-[#3A4D39]/5">
  <div class="container mx-auto flex flex-row items-center justify-between px-4 py-4 md:px-6">
    <a href="/" class="flex items-center gap-2 text-2xl font-bold tracking-tighter text-[#2F3E2E]">
      <Icon name="solar:leaf-linear" class="h-8 w-8" />
      <span>Lívia Gusmão</span>
    </a>

    <nav class="hidden md:flex gap-8 text-base font-medium text-[#4A5D49]">
      {links.map((link) => (
        <a href={link.to} class="hover:text-[#2F3E2E] transition-colors">
          {link.label}
        </a>
      ))}
    </nav>
    
    <div class="flex items-center gap-2" id="user-menu-container">
        <a href="#contato" class="hidden md:block rounded-full bg-[#3A4D39] px-5 py-2 text-sm font-medium text-white hover:bg-[#2F3E2E] transition-colors">
            Agendar
        </a>
    </div>
    
  </div>
</header>


